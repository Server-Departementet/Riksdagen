generator client {
  provider     = "prisma-client"
  moduleFormat = "esm"
  output       = "./generated"
}

datasource db {
  provider = "mysql"
}

model User {
  id   String  @id // Discord ID
  name String?

  trackPlays       TrackPlay[]
  spotifyAccount   SpotifyAccount?
  trackPlayFetches TrackPlayFetch[]
  importQueue      ImportQueueItem[]
}

// Takeout plays waiting for the server-side import. The import API only
// enqueues; scripts/process-import-queue.ts drains the queue from cron at a
// deliberately slow pace so the dev-mode Spotify app is never hammered.
model ImportQueueItem {
  id       BigInt   @id @default(autoincrement())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  trackId  String // Spotify track id — no FK: the track is usually not in the catalog yet
  playedAt DateTime
  queuedAt DateTime @default(now())
  status   String   @default("pending") // pending | done | duplicate | failed
  reason   String? // Why a failed row failed (track unresolvable etc.)

  // Re-uploading the same takeout file is a no-op
  @@unique([userId, trackId, playedAt])
  @@index([status])
}

// One row per minister per recently-played fetch (scripts/post-recent-plays.ts),
// pruned after 30 days. /spotify/log shows the latest runs so ministers can
// check their own imports.
model TrackPlayFetch {
  id    Int      @id @default(autoincrement())
  runAt DateTime // Shared by every row of one script run

  user   User   @relation(fields: [userId], references: [id])
  userId String

  status   String // ok | token-failed | fetch-failed | write-failed
  inserted Int     @default(0)
  skipped  Int     @default(0) // Plays already in the database
  detail   String? @db.Text

  @@index([runAt])
}

// Spotify OAuth refresh tokens, written by /api/auth/callback/spotify
// and consumed by scripts/post-recent-plays.ts
model SpotifyAccount {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])

  refreshToken String   @db.Text
  scope        String?
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TrackPlay {
  playedAt DateTime
  imported Boolean  @default(false) // Play came from a takeout history import, not the recently-played job

  user    User   @relation(fields: [userId], references: [id])
  userId  String
  track   Track  @relation(fields: [trackId], references: [id])
  trackId String

  @@id([trackId, playedAt, userId])
  @@index([playedAt])
}

model Track {
  id       String @id // Spotify's track UID
  ISRC     String
  url      String
  name     String
  duration Int // Milliseconds

  album      Album       @relation(fields: [albumId], references: [id])
  albumId    String
  artists    Artist[]
  TrackPlays TrackPlay[]
}

model Artist {
  id    String  @id // Spotify's artist UID
  name  String
  url   String
  image String?
  color String?

  tracks Track[]
  genres Genre[]
}

model Album {
  id          String    @id // Spotify's album UID
  name        String
  url         String
  image       String?
  color       String?
  releaseDate DateTime? @db.Date

  tracks Track[]
}

model Genre {
  name String @id // Spotify's genre name as ID

  artists Artist[]
}

// Canonical quotes are crawled from Discord by the Riksdagen-Bot repo, which
// injects a copy into this database (its src/quotes/web-sync.ts mirrors this
// model — keep them in sync). The web app only reads this table.
model Quote {
  id               String  @id // Discord message ID
  authorId         String
  createdTimestamp BigInt // ms epoch
  link             String
  originalLink     String?

  sender String
  body   String @db.Text
  quotee String

  quoteeId    String?
  context     String? @db.Text
  attachments Json?

  @@index([createdTimestamp])
}

// Citat quiz rounds and votes, copied in by the Riksdagen-Bot quiz (its own
// database is canonical; src/quiz/web-sync.ts there mirrors these models — keep
// them in sync). The web app only reads these tables, for /citat/stats.
model QuizRound {
  number    Int      @id // N in "Citat Quiz #N"
  messageId String   @unique // The poll message
  quoteId   String // No FK: the quote may have been deleted since
  kind      String // minister | external
  options   Json // Poll answer texts, in poll order
  postedAt  DateTime

  // Set once the results are posted
  resultMessageId String?   @unique
  correctAnswer   String?
  closedAt        DateTime?

  votes QuizVote[]

  @@index([quoteId])
}

model QuizVote {
  round       QuizRound @relation(fields: [roundNumber], references: [number], onDelete: Cascade)
  roundNumber Int
  userId      String // Discord ID of the voter
  answer      String // Poll answer text they picked
  correct     Boolean

  @@id([roundNumber, userId]) // Polls are single choice
  @@index([userId])
}
