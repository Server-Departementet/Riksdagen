generator client {
  provider     = "prisma-client"
  moduleFormat = "esm"
  output       = "./generated"
}

datasource db {
  provider = "mysql"
}

model User {
  id   String  @id // Discord ID
  name String?
  /// Most vibrant colour of their Discord avatar ("#rrggbb"), set by scripts/make-users.ts
  avatarColor String? @db.VarChar(7)

  trackPlays       TrackPlay[]
  spotifyAccount   SpotifyAccount?
  trackPlayFetches TrackPlayFetch[]
  importQueue      ImportQueueItem[]
  floorPlans       FloorPlan[]
  planTraces       PlanTrace[]
  furnitureSet     FurnitureSet?
  planComments     PlanComment[]
  planReactions    PlanReaction[]
}

// Takeout plays waiting for the server-side import. The import API only
// enqueues; scripts/process-import-queue.ts drains the queue from cron at a
// deliberately slow pace so the dev-mode Spotify app is never hammered.
model ImportQueueItem {
  id       BigInt   @id @default(autoincrement())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  trackId  String // Spotify track id — no FK: the track is usually not in the catalog yet
  playedAt DateTime
  queuedAt DateTime @default(now())
  status   String   @default("pending") // pending | done | duplicate | failed
  reason   String? // Why a failed row failed (track unresolvable etc.)

  // Re-uploading the same takeout file is a no-op
  @@unique([userId, trackId, playedAt])
  @@index([status])
}

// One row per minister per recently-played fetch (scripts/post-recent-plays.ts),
// pruned after 30 days. /spotify/log shows the latest runs so ministers can
// check their own imports.
model TrackPlayFetch {
  id    Int      @id @default(autoincrement())
  runAt DateTime // Shared by every row of one script run

  user   User   @relation(fields: [userId], references: [id])
  userId String

  status   String // ok | token-failed | fetch-failed | write-failed
  inserted Int     @default(0)
  skipped  Int     @default(0) // Plays already in the database
  detail   String? @db.Text

  @@index([runAt])
}

// Spotify OAuth refresh tokens, written by /api/auth/callback/spotify
// and consumed by scripts/post-recent-plays.ts
model SpotifyAccount {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])

  refreshToken String   @db.Text
  scope        String?
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TrackPlay {
  playedAt DateTime
  imported Boolean  @default(false) // Play came from a takeout history import, not the recently-played job

  user    User   @relation(fields: [userId], references: [id])
  userId  String
  track   Track  @relation(fields: [trackId], references: [id])
  trackId String

  @@id([trackId, playedAt, userId])
  @@index([playedAt])
}

model Track {
  id       String @id // Spotify's track UID
  ISRC     String
  url      String
  name     String
  duration Int // Milliseconds

  album      Album       @relation(fields: [albumId], references: [id])
  albumId    String
  artists    Artist[]
  TrackPlays TrackPlay[]
}

model Artist {
  id    String  @id // Spotify's artist UID
  name  String
  url   String
  image String?
  color String?

  tracks Track[]
  genres Genre[]
}

model Album {
  id          String    @id // Spotify's album UID
  name        String
  url         String
  image       String?
  color       String?
  releaseDate DateTime? @db.Date

  tracks Track[]
}

model Genre {
  name String @id // Spotify's genre name as ID

  artists Artist[]
}

// Canonical quotes are crawled from Discord by the Riksdagen-Bot repo, which
// injects a copy into this database (its src/quotes/web-sync.ts mirrors this
// model — keep them in sync). The web app only reads this table.
model Quote {
  id               String  @id // Discord message ID
  authorId         String
  createdTimestamp BigInt // ms epoch
  link             String
  originalLink     String?

  sender String
  body   String @db.Text
  quotee String

  quoteeId    String?
  /// Groups the spellings of a non-minister quotee (set by the bot's crawler); the quiz uses it
  quoteeKey   String?
  context     String? @db.Text
  attachments Json?

  @@index([createdTimestamp])
}

// Citat quiz rounds and votes, copied in by the Riksdagen-Bot quiz (its own
// database is canonical; src/quiz/web-sync.ts there mirrors these models — keep
// them in sync). The web app only reads these tables, for /citat/stats.
model QuizRound {
  number    Int      @id // N in "Citat Quiz #N"
  messageId String   @unique // The poll message
  quoteId   String // No FK: the quote may have been deleted since
  kind      String // minister | external
  options   Json // Poll answer texts, in poll order
  postedAt  DateTime

  // Set once the results are posted
  resultMessageId String?   @unique
  correctAnswer   String?
  closedAt        DateTime?

  votes QuizVote[]

  @@index([quoteId])
}

model QuizVote {
  round       QuizRound @relation(fields: [roundNumber], references: [number], onDelete: Cascade)
  roundNumber Int
  userId      String // Discord ID of the voter
  answer      String // Poll answer text they picked
  correct     Boolean

  @@id([roundNumber, userId]) // Polls are single choice
  @@index([userId])
}

// Flat layouts drawn by ministers on /planlosning. Every minister can read all
// of them; only the owner writes. `editedAt` is the editing browser's clock: a
// save is only accepted when it is newer than the stored one, so the latest
// edit wins when the same plan is open on several devices.
model FloorPlan {
  id      String @id // Generated in the browser, so a plan can be created before it reaches the server
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  name     String
  data     Json // PlanData, see src/lib/planner/plan.ts
  editedAt DateTime

  /// The cropped plan image the walls are traced from, served by /api/planlosning/[id]/image
  image     Bytes?  @db.MediumBlob
  imageType String?

  createdAt DateTime @default(now())

  @@index([ownerId])
}

// One "trace this floor plan for me" job on /planlosning: a Claude Managed Agents
// session that measures the plan picture and fills in a FloorPlan. The rows are
// also what the rate limits are counted from, so they are kept after the job ends.
model PlanTrace {
  id      String @id
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  status String // running | done | failed
  /// The FloorPlan being filled in. No FK: the minister may delete the plan while the job runs.
  planId String
  /// The Managed Agents session, once it exists. Lets a job be picked up again after a restart.
  sessionId String?
  /// The listing link, if one was given
  listingUrl String? @db.Text

  /// Tool calls made so far, as a rough progress figure
  step Int @default(0)
  /// While running: what the agent last said. Done: its report. Failed: why.
  note String? @db.Text
  /// What the session cost at list prices, in US cents
  costCents Int?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([ownerId, createdAt])
  @@index([status])
}

// "Mina möbler": the furniture a minister owns, kept apart from any plan and
// unpacked into each of theirs on /planlosning. One row per minister.
model FurnitureSet {
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @id

  items     Json // Item[] without positions, see sanitizeFurniture in src/lib/planner/plan.ts
  updatedAt DateTime @updatedAt
}

// Short comments ministers leave on each other's (and their own) plans on
// /planlosning. Plain text, never edited; the author or the plan's owner may
// delete one.
model PlanComment {
  id Int @id @default(autoincrement())
  /// The FloorPlan commented on. No FK: plan ids are made in the browser, and deleting a plan
  /// should not have to know about comments. Rows of plans that are gone are ignored, and swept
  /// by the comments API whenever someone posts (src/lib/planner/comments-server.ts).
  planId   String
  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([planId, id]) // Listing a plan's comments in order
  @@index([authorId, createdAt]) // The per-minister rate limit
}

// A minister's emoji reaction to a plan: at most one each, replaced or removed
// when they pick again.
model PlanReaction {
  planId String // No FK, as for PlanComment
  user   User   @relation(fields: [userId], references: [id])
  userId String
  /// A key from REACTIONS in src/lib/planner/comments.ts ("up", "heart", ...), not the emoji
  /// itself: utf8mb4_unicode_ci does not tell emoji apart.
  emoji String @db.VarChar(16)

  @@id([planId, userId])
  @@index([userId])
}
