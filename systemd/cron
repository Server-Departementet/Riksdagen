# Installed as the riks user's crontab (crontab -u riks systemd/cron).
# The maintenance reboot lives in systemd/cron.root.
# Spotify plays and quotes are injected into the database by the Riksdagen-Bot repo.
7 3     * * *   /home/riks/Riksdagen/systemd/tsx-log.sh scripts/make-users.ts >> /var/log/riksdagen-web/make-users.log 2>&1
# Drain the takeout import queue slowly; flock skips the tick if the last run is still going
*/5 *   * * *   flock -n /tmp/riksdagen-import-queue.lock /home/riks/Riksdagen/systemd/tsx-log.sh scripts/process-import-queue.ts >> /var/log/riksdagen-web/import-queue.log 2>&1
