# The web app's own database (includes the Quote table, injected by the Riksdagen-Bot repo)
DATABASE_URL="mysql://user:password@host:3306/riksdagen"
# For seeding (don't be silly, don't put this on the server)
REMOTE_DB_URL=""

# Session cookie signing secret, generate with e.g. `openssl rand -base64 32`
AUTH_SECRET=""

# For generating links and other stuff in the app (also the OAuth redirect base)
CANONICAL_URL="http://localhost:3000"

# Discord OAuth (login). Can be the same Discord application as the bot.
# Add "<CANONICAL_URL>/api/auth/callback/discord" as a redirect in the Discord developer portal.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Bot token + guild for scripts/make-users.ts (minister sync via Discord's REST API).
# The application needs the Server Members privileged intent.
DISCORD_BOT_TOKEN=""
REGERINGEN_GUILD_ID=""

# Spotify OAuth (ministers connect their account on /spotify; the refresh tokens
# are consumed by the Riksdagen-Bot repo's recent-plays job, which injects plays
# and the /spotify/log fetch log into this database)
# Add "<CANONICAL_URL>/api/auth/callback/spotify" as a redirect in the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Bot asset server (quote attachments) to relay /quote-attachments/* misses to.
# Optional; without it only files in this repo's public/ are served.
ASSET_SERVER_URL="http://riksdagen-bot.lan:3100"

# Seeding knobs (optional)
# SEED_SPOTIFY_FETCH_CONCURRENCY="5"
# SEED_DB_WRITE_CONCURRENCY="25"

# AI floor plan tracer on /planlosning (optional; without these the button is hidden).
# The key is an Anthropic API key. The two ids are printed by
# `./node_modules/.bin/tsx scripts/plan-tracer/setup.ts`, which creates the agent and its sandbox.
ANTHROPIC_API_KEY=""
PLAN_TRACER_AGENT_ID=""
PLAN_TRACER_ENVIRONMENT_ID=""
# The measuring toolkit (scripts/plan-tracer/planmeasure.py) as an uploaded file, also printed by the setup
# script; it prints a new id whenever the toolkit has changed. Without it the tracer still works, but the
# agent writes its own measuring code every time, which costs more.
PLAN_TRACER_TOOLKIT_FILE_ID=""
# Limits (these are the defaults). A trace costs real money, failed ones too.
# PLAN_TRACER_PER_MINISTER_PER_DAY="3"
# PLAN_TRACER_TOTAL_PER_DAY="10"
# PLAN_TRACER_CONCURRENT="2"
# PLAN_TRACER_MAX_COST_CENTS="500"   # hard ceiling per trace, US cents at list prices
# PLAN_TRACER_MAX_MINUTES="30"
# What a trace costs (see what each did in PlanTrace.costCents before settling on a change):
# How many times a second model may grade the result against the rubric and send the agent back.
# "1" grades once; "0" starts the trace with a plain message and no grader at all.
# PLAN_TRACER_GRADER_ITERATIONS="2"
# Only read by the setup script (rerun it after changing them): the model, and how hard it thinks
# (low, medium, high, xhigh, max). Lower effort means fewer output tokens, the largest part of a trace's cost.
# PLAN_TRACER_MODEL="claude-opus-5-5"
# PLAN_TRACER_EFFORT="high"
